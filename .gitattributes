# Binary assets. Served web files (images, compressed audio, fonts) stay in
# plain git so a checkout deploys them as they are; large authoring sources
# (Blender scenes, raw audio) live in Git LFS and are never deployed.
# After cloning: `git lfs install` once, then `git lfs pull`.

# Served assets: binary, no diffs, no merges, no line-ending changes.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.mp4   binary
*.ico   binary
*.mp3   binary
*.ogg   binary
*.webm  binary
*.m4a   binary
*.woff  binary
*.woff2 binary

# Authoring sources: Git LFS.
*.blend  filter=lfs diff=lfs merge=lfs -text
*.blend1 filter=lfs diff=lfs merge=lfs -text
*.wav    filter=lfs diff=lfs merge=lfs -text
*.flac   filter=lfs diff=lfs merge=lfs -text
*.aif    filter=lfs diff=lfs merge=lfs -text
*.aiff   filter=lfs diff=lfs merge=lfs -text
# The site's sample library ships, and a deploy checks out without LFS: plain files.
websites/www.cs/music/library/**/*.flac -filter -diff -merge binary
# The vocal take fixtures: the tests read their bytes, and CI checks out without LFS.
websites/www.cs/games/workroom/test/fixtures/takes/*.flac -filter -diff -merge binary
websites/*/games/*/audio/**/src/** filter=lfs diff=lfs merge=lfs -text

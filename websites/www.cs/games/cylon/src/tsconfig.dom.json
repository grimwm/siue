{
  // The modules that touch browser APIs (fetch, console, Date's locale, the
  // elements they are handed) but never look the document up themselves: the
  // same options as ../tsconfig.json plus the DOM lib. Each
  // config is its own program in tools/ts-build.mjs, so the modules listed only
  // in ../tsconfig.json still fail to compile if they use `fetch` or `document`.
  // Every module here also imports with its .js extension.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"]
  },
  "files": ["audio.ts", "field.ts", "intro.ts", "scores.ts"]
}

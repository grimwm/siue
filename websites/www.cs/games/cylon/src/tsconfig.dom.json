{
  // The modules that touch browser APIs (fetch, console, localStorage, the
  // document and window, the elements they are handed): the same options as
  // ../tsconfig.json plus the DOM lib. Each
  // config is its own program in tools/ts-build.mjs, so the modules listed only
  // in ../tsconfig.json still fail to compile if they use `fetch` or `document`.
  // Every module here also imports with its .js extension.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"]
  },
  "files": ["audio.ts", "chrome.ts", "eye.ts", "field.ts", "gameover.ts", "intro.ts", "landscape.ts", "reticle.ts", "scores.ts", "types.ts", "units.ts"]
}

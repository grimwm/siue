{
  "_schema": {
    "_note": "Operation Tankity effects, keyed by weapon key (plus laststand, the wreck blast). fx.js is the engine; fx-editor.html edits this file live. Fields not written on an emitter take the defaults documented in fx.js (DEFAULTS).",
    "weapon": {
      "body": "The shell itself: halo (glow radius px), alpha, pulse (Hz), stretch (px of light behind it).",
      "muzzle": "Effect, once, as the shell leaves the barrel. Position: the barrel tip; \"forward\" is the aim direction.",
      "trail": "Effect, every frame in flight. Emitters need a \"rate\" (particles/second); they drip along the path.",
      "impact": "Effect, on detonation, centred on the blast. Use unit \"r\" for what must scale with the blast radius (the crater and damage radius, which the arsenal in game.yaml owns and this file never changes).",
      "special": "Named extras. split: cluster bloom point. steer: seeker, while bending (rate emitters). pierce: lance, at the tank it passes through. arc: EMP, over each tank it fries."
    },
    "effect": {
      "emitters": "List of emitters.",
      "screen": "{ shake: 0..1 (omit to use the weapon gfx.shake in the arsenal), flash: { color, alpha, dur } }; no flash under reduced motion."
    },
    "emitter": {
      "shape": "dot | streak | ring | spark | smoke | sprite | bolt | beam. dot: round or square point (glow: soft blob). streak: line behind its velocity. ring: expanding outline. spark: four-point star. smoke: soft blob. sprite: Blender sheet frame. bolt: jagged lightning. beam: straight glowing line along the aim.",
      "count": "Particles in a burst.",
      "rate": "Particles per second (trail, or with duration).",
      "delay": "Seconds before the emitter starts.",
      "duration": "Seconds a rate emitter keeps going (impact).",
      "life": "[min, max] seconds.",
      "speed": "[min, max] px/s (r/s with unit \"r\"). Negative with edge flies inward.",
      "aim": "fixed | forward | back | normal (relative to the shell heading).",
      "angle": "Degrees counter-clockwise added to the aim (fixed: 0 right, 90 up).",
      "spread": "Cone width, degrees (360 = every way).",
      "offset": "Spawn within this distance of the point (px, or r with unit \"r\"); with edge, exactly on that circle.",
      "gravity": "px/s^2 downward (negative rises).",
      "drag": "Slowdown per second.",
      "wind": "How far the battlefield wind pushes it (0..1).",
      "size": "[min, max] at birth: radius (ring: start radius; spark: arm length; beam: half width).",
      "sizeEnd": "Size multiplier at death.",
      "ease": "linear | out | in, for the size change.",
      "alpha": "Keyframes 0..1 spread evenly over life.",
      "colors": "Colour ramp spread evenly over life.",
      "glow": "Additive compositing.",
      "round": "dot: round, or square pixels.",
      "length": "streak/beam/bolt length (px, or r with unit \"r\").",
      "width": "ring line width, px.",
      "unit": "px | r. With r, size, speed, offset and length are multiples of the blast radius.",
      "sheet": "sprite: sheet name from fx/sprites/sprites.json (fireball, smoke, shock, energy, mushroom).",
      "fps": "sprite: frames per second; 0 plays the sheet once over the life.",
      "scale": "sprite: extra size multiplier (the sprite spans 2 x size x scale).",
      "anchor": "sprite: center | bottom (bottom stands on the point).",
      "rotJitter": "Random start rotation, +/- degrees.",
      "spin": "[min, max] degrees/second.",
      "tint": "sprite: multiply the sheet by this colour."
    }
  },

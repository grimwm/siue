{
  // src/*.ts compiles one file to one file into js/, which is checked in and
  // loaded by the browser as native ES modules (no bundler). Build:
  // node tools/ts-build.mjs; verify: node tools/ts-build.mjs --check.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    // Imports are written with their .js extension (import ... from './sim.js'),
    // which is the file the browser fetches. The sim has no DOM, so no DOM
    // types: a module that needs the page adds "DOM" here.
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "js",
    // Readable output: the comments stay, and there are no source maps.
    "removeComments": false,
    "sourceMap": false,
    "newLine": "lf",
    "noEmitOnError": true
    // Preact overlays (later): "jsx": "react-jsx", "jsxImportSource": "preact"
  },
  "include": ["src"]
}

{
  "terms": [
    { "id": "ostinato", "word": "ostinato", "lines": ["A short pattern repeated over and over underneath the music.", "It drives the piece forward, like footsteps in the dark."] },
    { "id": "motif", "word": "motif", "lines": ["A short musical idea that stands for a person, a place or a feeling.", "Each time it returns, you know who or what is near."] },
    { "id": "theme", "word": "theme", "lines": ["The main tune of a piece or a scene, the one you remember.", "It can come back changed, slower, higher or darker."] },
    { "id": "phrygian", "word": "Phrygian", "lines": ["A minor-sounding scale whose second note is only a half step up.", "That half step gives an ancient, Mediterranean, uneasy colour."] },
    { "id": "crescendo", "word": "crescendo", "lines": ["Getting steadily louder.", "It builds tension, like footsteps coming closer."] },
    { "id": "decrescendo", "word": "decrescendo", "lines": ["Getting steadily quieter.", "It lets the tension drain away, like a voice trailing off."] },
    { "id": "octave", "word": "octave", "lines": ["The distance between a note and the next note with the same name, higher or lower.", "Two notes an octave apart sound like the same note in a bigger or smaller voice."] },
    { "id": "chord", "word": "chord", "lines": ["Three or more notes sounded together.", "Chords give the music its mood: bright, sad, tense or calm."] },
    { "id": "drone", "word": "drone", "lines": ["A long note that holds on underneath everything else.", "It sets a steady, ominous floor for the other sounds."] },
    { "id": "pedal-point", "word": "pedal point", "lines": ["One low note held or repeated while the harmony above it changes.", "It anchors the music and makes the changes above feel uneasy."] },
    { "id": "tremolo", "word": "tremolo", "lines": ["Playing one note again and again, very fast, so it shimmers.", "Strings do it with quick little bow strokes; it sounds trembling and nervous."] },
    { "id": "pizzicato", "word": "pizzicato", "lines": ["Plucking a string with a finger instead of drawing the bow.", "The notes come out short and light, like dripping water."] },
    { "id": "legato", "word": "legato", "lines": ["Playing notes smoothly, joined with no gaps between them.", "It sounds flowing and calm, like one long breath."] },
    { "id": "staccato", "word": "staccato", "lines": ["Playing notes short and detached, with gaps between them.", "It sounds sharp and bouncy, like quick footsteps."] },
    { "id": "tempo", "word": "tempo", "lines": ["How fast or slow the music goes.", "A fast tempo feels urgent; a slow one feels heavy or calm."] },
    { "id": "bar", "word": "bar", "lines": ["One small slice of the music that holds a set number of beats.", "Counting bars is how musicians say exactly where in a piece they are."] },
    { "id": "beat", "word": "beat", "lines": ["One steady pulse of the music, the thing you tap your foot to.", "Beats are grouped into bars."] },
    { "id": "dynamics", "word": "dynamics", "lines": ["How loud or quiet the music is, and how that changes.", "Soft passages and loud ones are what make a piece feel alive."] },
    { "id": "unison", "word": "unison", "lines": ["Everyone playing the same notes at the same time.", "It sounds bold and unified, like a whole crowd chanting together."] },
    { "id": "minor", "word": "minor", "lines": ["A scale or chord that sounds sad, dark or serious.", "Many tense or mournful pieces are built on minor sounds."] },
    { "id": "major", "word": "major", "lines": ["A scale or chord that sounds bright, open or happy.", "Triumphant fanfares are usually major."] },
    { "id": "cadence", "word": "cadence", "lines": ["The chords that close a musical phrase, like punctuation.", "Some feel finished like a full stop; others leave you hanging like a question."] },
    { "id": "orchestration", "word": "orchestration", "lines": ["Choosing which instruments play which parts.", "The same tune sounds heroic on horns and lonely on a single flute."] },
    { "id": "swell", "word": "swell", "lines": ["A sound that grows louder, and often fades back again.", "A swell of strings feels like a wave rising and falling."] },
    { "id": "attack", "word": "attack", "lines": ["How quickly a sound reaches its full loudness after it starts.", "A drum hit has a sharp attack; a slow string swell has a soft one."] },
    { "id": "decay", "word": "decay", "lines": ["How a sound falls from its first peak down to a steadier level.", "A cannon's boom drops away fast; a bell's ring decays slowly."] },
    { "id": "release", "word": "release", "lines": ["What a sound does after the key or trigger is let go.", "A short release stops it dead; a long one lets it fade away."] },
    { "id": "envelope", "word": "envelope", "lines": ["The shape of a sound's loudness over time: attack, decay, hold, release.", "It is why a plucked note and a bowed note feel so different."] },
    { "id": "layer", "word": "layer", "lines": ["One of several sounds played together to make one bigger sound.", "A cannon shot might layer a deep boom, a sharp crack and a rushing hiss."] },
    { "id": "transient", "word": "transient", "lines": ["The very short, sharp burst at the very start of a sound.", "It is the snap of a snare or the click of a button before the tone settles."] },
    { "id": "pitch-sweep", "word": "pitch sweep", "lines": ["A sound whose pitch slides up or down while it plays.", "A falling sweep makes a laser or a boom feel as if it drops away."] },
    { "id": "reverb-tail", "word": "reverb tail", "lines": ["The fading echo that lingers after a sound has stopped.", "A long tail makes a sound feel as if it happened in a cave or a cathedral."] },
    { "id": "foley", "word": "foley", "lines": ["Everyday sounds made by hand to match what is on screen.", "Footsteps, creaking leather and rustling cloth are all foley."] },
    { "id": "ambience", "word": "ambience", "lines": ["The quiet background sound that makes a place feel real.", "Wind, far-off machinery or a hum of insects sets the scene without being noticed."] },
    { "id": "low-pass-filter", "word": "low-pass filter", "lines": ["A filter that keeps the low sounds and cuts the high ones.", "It muffles a sound, like hearing music through a wall."] },
    { "id": "distortion", "word": "distortion", "lines": ["Deliberately overloading a sound so it turns rough and gritty.", "It adds bite and aggression, like an overdriven guitar or a crunchy explosion."] },
    { "id": "staff", "word": "staff", "match": [], "lines": ["The five lines that sheet music is written on.", "A note on a higher line or gap sounds higher, like a step up a ladder."] },
    { "id": "clef", "word": "clef", "lines": ["The sign at the start of each staff that says which note each line stands for.", "A treble clef is for higher instruments; a bass clef is for lower ones."] },
    { "id": "whole-note", "word": "whole note", "lines": ["An open oval with no stem: a note held for four beats.", "It is the longest note most music uses, a long held sound."] },
    { "id": "half-note", "word": "half note", "lines": ["An open oval with a stem: a note held for two beats.", "Two half notes last as long as one whole note."] },
    { "id": "quarter-note", "word": "quarter note", "lines": ["A filled-in oval with a stem: a note that lasts one beat.", "In most music it is the note you tap your foot to."] },
    { "id": "eighth-note", "word": "eighth note", "lines": ["A filled-in note with a flag, or joined to its neighbours by a beam: half a beat.", "Two eighth notes fit in one beat, like saying \"one-and\"."] },
    { "id": "dotted-note", "word": "dotted note", "lines": ["A note with a dot after it, which makes it half as long again.", "A dotted half note lasts three beats: two, plus half of two."] },
    { "id": "rest", "word": "rest", "match": ["quarter rest", "half rest", "whole rest", "eighth rest", "whole-bar rest"], "lines": ["A sign for silence: the instrument plays nothing for that long.", "Each note length has a matching rest, so the silences are counted as carefully as the notes."] },
    { "id": "time-signature", "word": "time signature", "lines": ["The two stacked numbers at the start of the music: beats in each bar over the kind of note that gets one beat.", "4 over 4 means four quarter-note beats in every bar: one, two, three, four."] },
    { "id": "key-signature", "word": "key signature", "lines": ["Sharps or flats written right after the clef, which hold for the whole piece.", "They save writing the same sign beside every note, and they hint at the music's home note."] },
    { "id": "accidental", "word": "accidental", "match": ["accidentals"], "lines": ["A sharp (♯), flat (♭) or natural (♮) sign beside a note, raising it, lowering it or putting it back.", "It lasts until the end of its bar, and often gives a sudden new colour."] },
    { "id": "half-step", "word": "half step", "lines": ["The smallest distance between two notes, like moving to the very next key on a piano.", "Melodies that move by half steps sound tense, like creeping."] },
    { "id": "tie", "word": "tie", "match": ["tied note", "tied notes"], "lines": ["A curved line joining two notes of the same pitch, played as one held note.", "It lets a note last across a bar line, like holding a breath over a page turn."] }
  ]
}

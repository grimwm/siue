#!/bin/sh
# usage: ensure-venv VENV_DIR REQUIREMENTS_FILE
# Makes the tool's virtualenv, and makes it again when it is missing or cannot import cryptography
# (a moved folder, an upgraded Python, a half-finished install). $SIUE_MUSIC_PYTHON picks the Python that builds it.
set -e
venv="$1"
requirements="$2"
base="${SIUE_MUSIC_PYTHON:-python3}"
if ! "$venv/bin/python" -c 'import cryptography' >/dev/null 2>&1; then
	rm -rf "$venv"
	"$base" -m venv "$venv"
	"$venv/bin/pip" install --quiet -r "$requirements"
fi
